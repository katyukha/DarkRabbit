<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dark_rabbit_exchange_tree" model="ir.ui.view">
        <field name="model">dark.rabbit.exchange</field>
        <field name="arch" type="xml">
            <list>
                <field name="connection_id"/>
                <field name="name"/>
                <field name="exchange_declare"/>
                <field name="exchange_durable"/>
                <field name="exchange_type"/>
            </list>
        </field>
    </record>

    <record id="view_dark_rabbit_exchange_form" model="ir.ui.view">
        <field name="model">dark.rabbit.exchange</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="active == True" />
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                        </group>
                        <group name="group_declare" string="Declare">
                            <field name="exchange_declare"/>
                            <field name="exchange_durable"/>
                            <field name="exchange_type" required="exchange_declare"/>
                        </group>
                        <group name="group_bindings" string="Bindings">
                            <field name="queue_binding_ids" mode="list" nolabel="1">
                                <list editable="bottom">
                                    <field name="queue_id"/>
                                    <field name="routing_key"/>
                                    <field name="bind"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dark_rabbit_exchange_search" model="ir.ui.view">
        <field name="model">dark.rabbit.exchange</field>
        <field name="arch" type="xml">
            <search>
                <field name="connection_id"/>
                <field name="name"/>

                <filter name="filter_active"
                        string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
            </search>
        </field>
    </record>

    <record id="action_dark_rabbit_exchange_list" model="ir.actions.act_window">
        <field name="name">Dark Rabbit Exchange</field>
        <field name="res_model">dark.rabbit.exchange</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_dark_rabbit_exchange_list"
              id="menu_dark_rabbit_exchange"
              sequence="45"
              parent="dark_rabbit.menu_dark_rabbit_root"/>

</odoo>
