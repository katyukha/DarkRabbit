<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dark_rabbit_outgoing_event_type_list" model="ir.ui.view">
        <field name="model">dark.rabbit.outgoing.event.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_dark_rabbit_outgoing_event_type_form" model="ir.ui.view">
        <field name="model">dark.rabbit.outgoing.event.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

<record id="action_dark_rabbit_outgoing_event_type_list" model="ir.actions.act_window">
        <field name="name">Dark Rabbit Outgoing Routing Type</field>
        <field name="res_model">dark.rabbit.outgoing.event.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_dark_rabbit_outgoing_event_type_list"
              id="menu_dark_rabbit_outgoing_event_type"
              sequence="70"
              parent="dark_rabbit.menu_dark_rabbit_root"/>

</odoo>
