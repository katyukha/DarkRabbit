<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dark_rabbit_schema_list" model="ir.ui.view">
        <field name="model">dark.rabbit.schema</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dark_rabbit_schema_form" model="ir.ui.view">
        <field name="model">dark.rabbit.schema</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <field name="name"
                               nolabel="1"
                               placeholder="Schema name…"/>
                    </div>
                    <group>
                        <separator string="Schema definition" colspan="2"/>
                        <field name="spec"
                               nolabel="1"
                               colspan="2"
                               widget="code"
                               class="mb-4"/>
                        <div class="alert alert-info mb-4" colspan="2">
                            <h4 class="alert-heading">Info and specification</h4>
                            <div class="pd-4">
                                Below is description of schema specification:
                            </div>
                            <pre class="pd-4 text-info" style="background-color: inherit"><code><![CDATA[
exchanges:
- name: <string>        # required
  declare: <bool>       # default: true
  type: <string>        # default: topic  (topic|direct|fanout|headers)
  durable: <bool>       # default: true

queues:
- name: <string>        # required
  declare: <bool>       # default: true
  durable: <bool>       # default: true
  exclusive: <bool>     # default: false
  auto_delete: <bool>   # default: false
  dlx: <string>         # dead-letter exchange name (optional)
  dlq_routing: <string> # dead-letter routing key (optional)
  bindings:
    - exchange: <string>    # required
      routing_key: <string> # default: ""
                            ]]></code></pre>
                            <hr/>
                            <div class="pd-4">
                                When merging multiple schemas:
                                <ul>
                                    <li>identical entities are merged silently</li>
                                    <li>conflicting structural fields (type, durable, exclusive …) raise an error before anything is written</li>
                                    <li><code>declare: true</code> from any schema wins</li>
                                    <li>bindings are unioned and deduplicated.</li>
                                </ul>
                            </div>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dark_rabbit_schema_list" model="ir.actions.act_window">
        <field name="name">Dark Rabbit Schema</field>
        <field name="res_model">dark.rabbit.schema</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_dark_rabbit_schema_list"
              id="menu_dark_rabbit_schema"
              sequence="100"
              parent="dark_rabbit.menu_dark_rabbit_root"/>

</odoo>
