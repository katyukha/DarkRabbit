<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dark_rabbit_outgoing_event_tree" model="ir.ui.view">
        <field name="model">dark.rabbit.outgoing.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="created_at"/>
                <field name="outgoing_event_type_id"/>
                <field name="connection_id"/>
                <field name="exchange"/>
                <field name="routing_key"/>
                <field name="message_id"/>
                <field name="correlation_id"/>
                <field name="sent_at"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="view_dark_rabbit_outgoing_event_form" model="ir.ui.view">
        <field name="model">dark.rabbit.outgoing.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <group>
                            <field name="outgoing_event_type_id"/>
                            <field name="connection_id"/>
                            <field name="exchange"/>
                            <field name="routing_key"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="timestamp"/>
                            <field name="sent_at"/>
                            <field name="message_type"/>
                            <field name="message_id"/>
                            <field name="correlation_id"/>
                            <field name="content_type"/>
                        </group>
                        <group colspan="2" string="Body">
                            <field name="body" nolabel="1" colspan="2" invisible="body_json_pretty"/>
                            <field name="body_json_pretty" nolabel="1" colspan="2" invisible="not body_json_pretty" widget="code" options="{'mode': 'javascript'}"/>
                        </group>
                        <group colspan="2" string="Error info" invisible="not error">
                            <field name="error"/>
                            <field name="error_msg" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dark_rabbit_outgoing_event_search" model="ir.ui.view">
        <field name="model">dark.rabbit.outgoing.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="connection_id" />
                <field name="outgoing_event_type_id"/>
                <field name="exchange"/>
                <field name="routing_key"/>
                <field name="message_id"/>
                <field name="message_type"/>
                <field name="correlation_id"/>
                <field name="created_at"/>
                <field name="sent_at"/>

                <filter name="filter_with_error"
                        string="Error"
                        domain="[('error', '=', True)]"/>
                <filter name="filter_without_error"
                        string="No error"
                        domain="[('error', '=', False)]"/>
                <separator/>

                <group expand="1" string="Group By">
                    <filter
                        string="Date"
                        name="group_by_created_at"
                        context="{'group_by':'created_at'}"
                    />
                    <filter
                        string="Connection"
                        name="group_by_connection_id"
                        context="{'group_by':'connection_id'}"
                    />
                    <filter
                        string="Outgoing Event Type"
                        name="group_by_outgoing_event_type_id"
                        context="{'group_by':'outgoing_event_type_id'}"
                    />
                    <filter
                        string="Error"
                        name="group_by_error"
                        context="{'group_by':'error'}"
                    />
                </group>

                <searchpanel view_types="list,pivot,graph">
                    <field name="connection_id" string="Connection" select="multi"/>
                    <field name="outgoing_event_type_id" string="Outgoing Event Type" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_dark_rabbit_outgoing_event_list" model="ir.actions.act_window">
        <field name="name">Dark Rabbit Outgoing Event</field>
        <field name="res_model">dark.rabbit.outgoing.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_dark_rabbit_outgoing_event_list"
              id="menu_dark_rabbit_outgoing_event"
              sequence="70"
              parent="dark_rabbit.menu_dark_rabbit_root"/>

</odoo>
