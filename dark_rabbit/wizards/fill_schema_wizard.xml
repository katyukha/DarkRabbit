<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dark_rabbit_fill_schema_wizard_form" model="ir.ui.view">
        <field name="model">dark.rabbit.fill.schema.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Schema from Connection">
                <group>
                    <field name="connection_id"/>
                </group>
                <group>
                    <div class="o_dark_rabbit_schema_spec" colspan="2">
                        <field name="spec"
                               nolabel="1"
                               widget="ace"
                               readonly="not connection_id"
                               placeholder="Select a connection to preview the generated spec…"/>
                    </div>
                </group>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Apply to Schema"
                            class="btn-primary"
                            invisible="not spec"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dark_rabbit_fill_schema_wizard"
            model="ir.actions.act_window">
        <field name="name">Fill Schema from Connection</field>
        <field name="res_model">dark.rabbit.fill.schema.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
